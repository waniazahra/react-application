import { useState } from "react";

const LINES = [
  [0, 1, 2], [3, 4, 5], [6, 7, 8],
  [0, 3, 6], [1, 4, 7], [2, 5, 8],
  [0, 4, 8], [2, 4, 6],
];

function getResult(squares) {
  for (const [a, b, c] of LINES) {
    if (squares[a] && squares[a] === squares[b] && squares[a] === squares[c]) {
      return { winner: squares[a], line: [a, b, c] };
    }
  }
  if (squares.every(Boolean)) return { winner: "draw", line: [] };
  return null;
}

function Square({ value, onClick, highlighted, disabled }) {
  return (
    <button
      onClick={onClick}
      disabled={disabled}
      style={{
        width: "100%",
        height: "100%",
        background: "transparent",
        border: "none",
        fontFamily: "'Kalam', cursive",
        fontSize: "clamp(2.5rem, 10vw, 4rem)",
        fontWeight: 700,
        color: value === "X" ? "#E8795F" : value === "O" ? "#7FB3D5" : "transparent",
        cursor: disabled ? "default" : "pointer",
        transition: "transform 0.15s ease, text-shadow 0.2s ease",
        textShadow: highlighted
          ? value === "X"
            ? "0 0 18px rgba(232,121,95,0.85)"
            : "0 0 18px rgba(127,179,213,0.85)"
          : "none",
      }}
      onMouseEnter={(e) => {
        if (!disabled && !value) e.currentTarget.style.transform = "scale(1.05)";
      }}
      onMouseLeave={(e) => {
        e.currentTarget.style.transform = "scale(1)";
      }}
    >
      {value}
    </button>
  );
}

export default function TicTacToe() {
  const [squares, setSquares] = useState(Array(9).fill(null));
  const [xIsNext, setXIsNext] = useState(true);
  const [scores, setScores] = useState({ X: 0, O: 0, draw: 0 });
  const [tallied, setTallied] = useState(false);

  const result = getResult(squares);
  const winner = result?.winner ?? null;

  if (result && !tallied) {
    setScores((s) => ({ ...s, [result.winner]: s[result.winner] + 1 }));
    setTallied(true);
  }

  function handleClick(i) {
    if (squares[i] || winner) return;
    const next = squares.slice();
    next[i] = xIsNext ? "X" : "O";
    setSquares(next);
    setXIsNext(!xIsNext);
  }

  function newRound() {
    setSquares(Array(9).fill(null));
    setXIsNext(true);
    setTallied(false);
  }

  function resetMatch() {
    setScores({ X: 0, O: 0, draw: 0 });
    newRound();
  }

  let status;
  if (winner === "draw") status = "It's a draw — chalk it up to a clean slate.";
  else if (winner) status = `${winner} takes the round.`;
  else status = `${xIsNext ? "X" : "O"}'s move`;

  return (
    <div
      style={{
        minHeight: "100vh",
        width: "100%",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        background:
          "radial-gradient(ellipse at 30% 20%, #223a2c 0%, #16261c 55%, #10201782%25 100%)",
        backgroundColor: "#16261c",
        padding: "2rem 1rem",
        boxSizing: "border-box",
      }}
    >
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&family=Space+Mono:wght@400;700&display=swap');
      `}</style>

      <div style={{ width: "100%", maxWidth: "420px", textAlign: "center" }}>
        <h1
          style={{
            fontFamily: "'Kalam', cursive",
            fontWeight: 700,
            fontSize: "clamp(2rem, 8vw, 3rem)",
            color: "#F4F1E4",
            margin: "0 0 0.25rem 0",
            letterSpacing: "0.5px",
          }}
        >
          Tic Tac Toe
        </h1>
        <p
          style={{
            fontFamily: "'Space Mono', monospace",
            color: "#E8C468",
            fontSize: "0.95rem",
            margin: "0 0 1.5rem 0",
            minHeight: "1.4rem",
          }}
        >
          {status}
        </p>

        <div
          style={{
            position: "relative",
            width: "100%",
            aspectRatio: "1 / 1",
            background: "rgba(0,0,0,0.15)",
            borderRadius: "12px",
            padding: "12px",
            boxSizing: "border-box",
            boxShadow: "inset 0 2px 12px rgba(0,0,0,0.35)",
          }}
        >
          <div
            style={{
              display: "grid",
              gridTemplateColumns: "repeat(3, 1fr)",
              gridTemplateRows: "repeat(3, 1fr)",
              width: "100%",
              height: "100%",
              gap: 0,
            }}
          >
            {squares.map((val, i) => {
              const row = Math.floor(i / 3);
              const col = i % 3;
              const highlighted = result?.line?.includes(i);
              return (
                <div
                  key={i}
                  style={{
                    borderRight: col < 2 ? "3px solid #E8C46866" : "none",
                    borderBottom: row < 2 ? "3px solid #E8C46866" : "none",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                  }}
                >
                  <Square
                    value={val}
                    onClick={() => handleClick(i)}
                    highlighted={highlighted}
                    disabled={!!winner}
                  />
                </div>
              );
            })}
          </div>
        </div>

        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            fontFamily: "'Space Mono', monospace",
            color: "#CFCABB",
            fontSize: "0.85rem",
            margin: "1.25rem 0",
            padding: "0 0.25rem",
          }}
        >
          <span style={{ color: "#E8795F" }}>X: {scores.X}</span>
          <span>Draws: {scores.draw}</span>
          <span style={{ color: "#7FB3D5" }}>O: {scores.O}</span>
        </div>

        <div style={{ display: "flex", gap: "0.75rem", justifyContent: "center" }}>
          <button
            onClick={newRound}
            style={{
              fontFamily: "'Space Mono', monospace",
              background: "#E8C468",
              color: "#16261c",
              border: "none",
              borderRadius: "6px",
              padding: "0.6rem 1.1rem",
              fontSize: "0.85rem",
              fontWeight: 700,
              cursor: "pointer",
            }}
          >
            {winner ? "Next round" : "Restart round"}
          </button>
          <button
            onClick={resetMatch}
            style={{
              fontFamily: "'Space Mono', monospace",
              background: "transparent",
              color: "#CFCABB",
              border: "1px solid #CFCABB55",
              borderRadius: "6px",
              padding: "0.6rem 1.1rem",
              fontSize: "0.85rem",
              cursor: "pointer",
            }}
          >
            Reset match
          </button>
        </div>
      </div>
    </div>
  );
}
